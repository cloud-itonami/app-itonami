{
  "name": "kotodama-it0n4m1x",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "alias": {
    "@etzhayyim/kotodama-host-sdk": "../../../../kotoba-lang/kotodama-host/sdk/kotodama-host-sdk/src/index.ts",
    "@etzhayyim/xrpc/transport": "../../../../kotoba-lang/xrpc/src/transport.ts",
    "@etzhayyim/xrpc/auth": "../../../../kotoba-lang/xrpc/src/auth.ts",
    "@etzhayyim/xrpc/error": "../../../../kotoba-lang/xrpc/src/error.ts",
    "@etzhayyim/xrpc/nsid": "../../../../kotoba-lang/xrpc/src/nsid.ts",
    "@etzhayyim/xrpc/encode": "../../../../kotoba-lang/xrpc/src/encode.ts"
  },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "itonami",
    "APP_CAPABILITIES": "[\"aircraft-lifecycle-simulation\",\"unspsc-bom\",\"isic-supplier\",\"digital-twin\"]",
    "APP_DESCRIPTION": "Aircraft engine lifecycle simulation — design, procurement, assembly, testing, and digital twin flight operation",
    "APP_DISPLAY_NAME": "Itonami",
    "APP_EMBED_URL": "https://itonami.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "ts-native",
    "APP_NANOID": "it0n4m1x",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "r2_buckets": [
    { "binding": "YATA_R2", "bucket_name": "etzhayyim-cache" },
    { "binding": "CACHE_R2", "bucket_name": "etzhayyim-cache" }
  ],
  "services": [
    { "binding": "PDS_SERVICE", "service": "etzhayyim-pds-2603241700" },
    { "binding": "PDS_RPC", "service": "etzhayyim-pds-2603241700", "entrypoint": "PdsRPC" },
    { "binding": "MURAKUMO_SERVICE", "service": "etzhayyim-murakumo-2603241700" }
  ],
  "secrets_store_secrets": [
    { "binding": "SS_YATA_S3_KEY_ID", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "yata_s3_key_id" },
    { "binding": "SS_YATA_S3_SECRET_KEY", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "yata_s3_secret_key" },
    { "binding": "SS_SIGNING_KEY", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "signing_key" }
  ],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"] }
  ],
  "routes": [
    { "pattern": "it0n4m1x.etzhayyim.com/*", "zone_name": "etzhayyim.com" },
    { "pattern": "itonami.etzhayyim.com/*", "zone_name": "etzhayyim.com" }
  ]
}
