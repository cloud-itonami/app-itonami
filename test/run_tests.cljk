(ns run-tests
  "kbb 実行のテスト runner（guest 側ゲートは amu test、3 ターゲット）。"
  (:require [clojure.test :refer [run-tests]]
            [cloud-itonami.app-itonami.lifecycle-test]))

(let [{:keys [fail error]} (run-tests 'cloud-itonami.app-itonami.lifecycle-test)]
  (when (pos? (+ fail error))
    (set! (.-exitCode js/process) 1)))
